{
  "description": "NAP lane rules: the Engineer never edits tests, and the Test Engineer never reads or edits implementation code.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/lanes.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
